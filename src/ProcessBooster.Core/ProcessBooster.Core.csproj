<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ProcessBooster.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Interop marshalling analyzer noise; the interop is hand-verified. -->
    <NoWarn>$(NoWarn);CA1401;SYSLIB1054</NoWarn>
  </PropertyGroup>

</Project>
