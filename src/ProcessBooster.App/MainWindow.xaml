        </TabControl>

        <Border Grid.Row="2" Padding="12,6" Background="#16000000">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button Content="Copy specs" Command="{Binding CopySpecsCommand}" Margin="0,0,8,0" />
