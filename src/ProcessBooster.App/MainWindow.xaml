<ui:FluentWindow x:Class="ProcessBooster.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:core="clr-namespace:ProcessBooster.Core.Models;assembly=ProcessBooster.Core"
                 xmlns:vm="clr-namespace:ProcessBooster.App.ViewModels"
                 xmlns:beh="clr-namespace:ProcessBooster.App.Behaviors"
                 Title="Process Booster"
                 Width="1400" Height="840" MinWidth="1120" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6" />

        <Style x:Key="TabIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Tab header text is white; the selected tab adds semibold on its purple fill. -->
        <Style x:Key="TabHeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Selected tab: the whole tab fills purple (white text/icon). -->
        <Style x:Key="MainTab" TargetType="TabItem">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                TextElement.Foreground="White"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPurple}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkable option in a right-click submenu; tick reflects the value applied now.
             StaysOpenOnClick keeps the menu up so several settings can be changed in one go. -->
        <Style x:Key="OptionMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="StaysOpenOnClick" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding Command}" />
        </Style>

        <!-- One logical-CPU checkbox in the affinity list; stays open so several can be toggled. -->
        <Style x:Key="CoreMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="StaysOpenOnClick" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
        </Style>

        <!-- Reference-guide text on the Booster Rules tab. -->
        <Style x:Key="RefName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="RefBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Shared layout for every hardware tab: note + live tiles + detail cards -->
        <DataTemplate DataType="{x:Type vm:HardwareTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Note}" Foreground="#F0B400" TextWrapping="Wrap" Margin="4,0,4,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Width="150" Margin="4,4,4,10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Opacity="0.65" FontSize="11" />
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Graphs}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="4,4,4,10" Padding="14,10">
                                    <StackPanel>
                                        <DockPanel Width="300">
                                            <TextBlock Text="{Binding Title}" Opacity="0.7" FontSize="12" />
                                            <TextBlock Text="{Binding Current}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Border Width="300" Height="46" Margin="0,6,0,0" ClipToBounds="True">
                                            <Polyline Points="{Binding Points}" Stroke="{StaticResource AccentPurple}"
                                                      StrokeThickness="2" StrokeLineJoin="Round" />
                                        </Border>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Width="560" Margin="4,4,4,12" Padding="18" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.6" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Sensors tab: live per-device sensor dump -->
        <DataTemplate DataType="{x:Type vm:SensorsTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Note}" Foreground="#F0B400" TextWrapping="Wrap" Margin="4,0,4,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Width="380" Margin="4,4,4,12" Padding="16" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Readings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Table tabs: Startup / Software / Services / Environment as sortable data grids -->
        <DataTemplate DataType="{x:Type vm:TableTabViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,12,10,8">
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8" />
                                <ui:Card Padding="0">
                                    <DataGrid ItemsSource="{Binding Rows}"
                                              beh:GridColumns.Headers="{Binding Columns}"
                                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" CanUserResizeRows="False" CanUserAddRows="False"
                                              CanUserResizeColumns="True" CanUserSortColumns="True"
                                              SelectionMode="Single" SelectionUnit="FullRow" RowHeight="28"
                                              Background="Transparent" BorderThickness="0" MaxHeight="640"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8B5CF6" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#8B5CF6" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                        </DataGrid.Resources>
                                    </DataGrid>
                                </ui:Card>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Process Booster">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="12,4,12,6" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <!-- ============================ PROCESSES ============================ -->
            <TabItem Style="{StaticResource MainTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Apps24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Processes" Style="{StaticResource TabHeaderText}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,8,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left"
                                    PlaceholderText="Search processes by name or PID…"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                        ToolTip="When on, Process Booster keeps re-applying your saved rules to matching processes (including new instances as they launch). Turn off to pause enforcement.">
                                <TextBlock Text="Auto-apply rules" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.85" />
                                <ui:ToggleSwitch IsChecked="{Binding EngineRunning, Mode=TwoWay}" />
                            </StackPanel>
                            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Import" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Export" Appearance="Primary" Command="{Binding ExportCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="0">
                            <DataGrid ItemsSource="{Binding ProcessView}"
                                      SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      CanUserResizeRows="False" CanUserAddRows="False" CanUserSortColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      Background="Transparent" BorderThickness="0" RowHeight="30"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8B5CF6" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#8B5CF6" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding ExePath}" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_RightClick" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="CPU priority" ItemsSource="{Binding CpuPriorityMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="CPU affinity — hard limit"
                                                  ToolTip="Strict: the process can ONLY run on the ticked cores. Best for firmly pinning a game to Performance cores.">
                                            <MenuItem Header="All cores (P + E)" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding AffinityIsAllCores, Mode=OneWay}"
                                                      Command="{Binding AffinityPresetCommand}" CommandParameter="all" />
                                            <MenuItem Header="Performance cores (P)" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding AffinityIsPerformance, Mode=OneWay}"
                                                      Command="{Binding AffinityPresetCommand}" CommandParameter="p" />
                                            <MenuItem Header="Efficiency cores (E)" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding AffinityIsEfficiency, Mode=OneWay}"
                                                      Command="{Binding AffinityPresetCommand}" CommandParameter="e" />
                                            <Separator />
                                            <MenuItem Header="Choose cores…" ItemsSource="{Binding AffinityCores}" ItemContainerStyle="{StaticResource CoreMenuItem}" />
                                        </MenuItem>
                                        <MenuItem Header="CPU sets — preferred cores" ItemsSource="{Binding CpuSetMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}"
                                                  ToolTip="Softer: asks Windows to favor these cores but still allow others when needed (the mechanism Game Mode uses)." />
                                        <MenuItem Header="I/O priority" ItemsSource="{Binding IoMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="Memory priority" ItemsSource="{Binding MemoryMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="GPU priority" ItemsSource="{Binding GpuSchedulingMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="GPU preference (applies on relaunch)" ItemsSource="{Binding GpuPreferenceMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="Efficiency mode" ItemsSource="{Binding EfficiencyMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="Priority boost" ItemsSource="{Binding BoostMenu}" ItemContainerStyle="{StaticResource OptionMenuItem}" />
                                        <MenuItem Header="Power profile" ItemsSource="{Binding PowerProfiles}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="IsCheckable" Value="True" />
                                                    <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}" />
                                                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Trim memory (empty working set)" Command="{Binding TrimMemoryCommand}" />
                                        <MenuItem Header="Copy rule / settings" Command="{Binding CopyRuleCommand}" />
                                        <MenuItem Header="Remove saved rule" Command="{Binding RemoveRuleCommand}" />
                                        <Separator />
                                        <MenuItem Header="Restart" Command="{Binding RestartProcessCommand}" />
                                        <MenuItem Header="Restart as admin" Command="{Binding RestartAsAdminCommand}" />
                                        <MenuItem Header="Close" Command="{Binding CloseProcessCommand}" />
                                        <MenuItem Header="Terminate" Command="{Binding TerminateProcessCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="2*" SortMemberPath="Name" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.7*" />
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0}}" Width="0.7*" SortMemberPath="CpuPercent" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Cpu}" Width="1.1*" />
                                    <DataGridTextColumn Header="Cores" Binding="{Binding Affinity}" Width="0.9*" />
                                    <DataGridTextColumn Header="I/O" Binding="{Binding Io}" Width="0.8*" />
                                    <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="0.9*" />
                                    <DataGridTextColumn Header="Eco" Binding="{Binding Eco}" Width="0.5*" />
                                    <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="0.7*" SortMemberPath="Threads" />
                                    <DataGridTextColumn Header="RAM" Binding="{Binding WorkingSet}" Width="0.9*" />
                                    <DataGridTextColumn Header="Rules" Binding="{Binding Rule}" Width="1.1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="0">
                            <TabControl>
                                <TabItem Header="Rule">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Editor.TargetHeader}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Editor.TargetExePath}" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,2,0,14" />
                                            <StackPanel IsEnabled="{Binding Editor.HasTarget}">
                                                <TextBlock Text="CPU priority" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.CpuPriorityOptions}" SelectedItem="{Binding Editor.SelectedCpuPriority, Mode=TwoWay}" />
                                                <TextBlock Text="CPU affinity (tick the cores to allow — all ticked = no limit)" Style="{StaticResource FieldLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <ui:Button Content="All (P+E)" Command="{Binding Editor.AffinityPresetCommand}" CommandParameter="all" Padding="8,2" Margin="0,0,6,0" />
                                                    <ui:Button Content="P-cores" Command="{Binding Editor.AffinityPresetCommand}" CommandParameter="p" Padding="8,2" Margin="0,0,6,0" />
                                                    <ui:Button Content="E-cores" Command="{Binding Editor.AffinityPresetCommand}" CommandParameter="e" Padding="8,2" />
                                                </StackPanel>
                                                <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8">
                                                    <ItemsControl ItemsSource="{Binding Editor.AffinityCores}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Index}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          MinWidth="42" Margin="2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <TextBlock Text="I/O priority" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.IoOptions}" SelectedItem="{Binding Editor.SelectedIo, Mode=TwoWay}" />
                                                <TextBlock Text="Memory priority" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.MemoryOptions}" SelectedItem="{Binding Editor.SelectedMemory, Mode=TwoWay}" />
                                                <TextBlock Text="Efficiency mode (EcoQoS)" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.EfficiencyOptions}" SelectedItem="{Binding Editor.SelectedEfficiency, Mode=TwoWay}" />
                                                <TextBlock Text="Priority boost" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.BoostOptions}" SelectedItem="{Binding Editor.SelectedBoost, Mode=TwoWay}" />
                                                <TextBlock Text="CPU sets" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.CpuSetOptions}" SelectedItem="{Binding Editor.SelectedCpuSet, Mode=TwoWay}" />
                                                <ui:TextBox Margin="0,6,0,0"
                                                            Text="{Binding Editor.CustomCpuSetText, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="custom core list, e.g. 0-7"
                                                            Visibility="{Binding Editor.IsCustomCpuSet, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="GPU preference" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.GpuPreferenceOptions}" SelectedItem="{Binding Editor.SelectedGpuPreference, Mode=TwoWay}" />
                                                <TextBlock Text="GPU scheduling priority" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding Editor.GpuSchedulingOptions}" SelectedItem="{Binding Editor.SelectedGpuScheduling, Mode=TwoWay}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                    <ui:Button Content="Apply now" Appearance="Secondary" Command="{Binding ApplyNowCommand}" Margin="0,0,8,0" />
                                                    <ui:Button Content="Save rule" Appearance="Primary" Command="{Binding SaveRuleCommand}" Margin="0,0,8,0" />
                                                    <ui:Button Content="Remove" Command="{Binding RemoveRuleCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Activity">
                                    <ListBox ItemsSource="{Binding LogLines}" Margin="6"
                                             FontFamily="Consolas" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,1" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </TabItem>
                            </TabControl>
                        </ui:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ BOOSTER RULES ============================ -->
            <TabItem Style="{StaticResource MainTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" Style="{StaticResource TabIcon}" />
                        <TextBlock Text="Booster Rules" Style="{StaticResource TabHeaderText}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4,8,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"
                                   Text="Saved booster rules — the settings Process Booster keeps applied to each matching process. Select a rule to apply, enable/disable or remove it." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Apply now" Command="{Binding ApplySelectedRuleCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Enable / Disable" Command="{Binding ToggleRuleEnabledCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Remove" Command="{Binding RemoveSelectedRuleCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Remove all" Command="{Binding RemoveAllRulesCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="0">
                          <Grid>
                            <DataGrid ItemsSource="{Binding BoosterRules}"
                                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  CanUserResizeRows="False" CanUserAddRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="Transparent" BorderThickness="0" RowHeight="30"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8B5CF6" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#8B5CF6" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_RightClick" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Apply now" Command="{Binding ApplySelectedRuleCommand}" />
                                    <MenuItem Header="Enable / Disable" Command="{Binding ToggleRuleEnabledCommand}" />
                                    <Separator />
                                    <MenuItem Header="Remove rule" Command="{Binding RemoveSelectedRuleCommand}" />
                                    <MenuItem Header="Remove all rules" Command="{Binding RemoveAllRulesCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.4*" SortMemberPath="Process" />
                                <DataGridTextColumn Header="Status" Binding="{Binding RunningText}" Width="1*" />
                                <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="0.7*" />
                                <DataGridTextColumn Header="Priority" Binding="{Binding Cpu}" Width="1*" />
                                <DataGridTextColumn Header="Cores" Binding="{Binding Affinity}" Width="1*" />
                                <DataGridTextColumn Header="I/O" Binding="{Binding Io}" Width="0.8*" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="0.9*" />
                                <DataGridTextColumn Header="Eco" Binding="{Binding Eco}" Width="0.6*" />
                                <DataGridTextColumn Header="Boost" Binding="{Binding Boost}" Width="0.8*" />
                                <DataGridTextColumn Header="CPU sets" Binding="{Binding CpuSets}" Width="1*" />
                                <DataGridTextColumn Header="GPU pref" Binding="{Binding GpuPref}" Width="1*" />
                                <DataGridTextColumn Header="GPU prio" Binding="{Binding GpuSched}" Width="1*" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.2*" />
                            </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No booster rules yet. In the Processes tab, select a process, choose settings in the Rule panel and click Save rule — it will show up here."
                                       Visibility="{Binding HasNoBoosterRules, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="440" Opacity="0.6" FontSize="14" IsHitTestVisible="False" />
                          </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Reference — what each setting does" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="A quick guide to the options you set per rule and in the right-click menu." />

                                    <TextBlock Style="{StaticResource RefName}" Text="CPU priority" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Share of CPU time vs other processes. Idle / Below normal yield to foreground apps; Above normal / High push this one ahead. Realtime can starve Windows itself — use sparingly." />

                                    <TextBlock Style="{StaticResource RefName}" Text="CPU affinity — hard limit" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="A strict restriction: the process can ONLY run on the ticked cores. Pin a game to Performance (P) cores to keep it off the slower Efficiency (E) cores. All ticked = no limit." />

                                    <TextBlock Style="{StaticResource RefName}" Text="CPU sets — preferred cores" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="A softer version of affinity: it asks Windows to prefer the chosen cores but still lets it use others when needed. This is what Windows Game Mode uses. Use affinity to force, CPU sets to nudge." />

                                    <TextBlock Style="{StaticResource RefName}" Text="I/O priority" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Disk read/write scheduling. Very low and Low keep background disk activity from stalling your game; Normal is the default for active apps." />

                                    <TextBlock Style="{StaticResource RefName}" Text="Memory priority" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="How readily the process's RAM pages are trimmed under pressure. Very low / Low give up memory first; Normal keeps pages resident longer." />

                                    <TextBlock Style="{StaticResource RefName}" Text="Efficiency mode (EcoQoS)" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Runs the process on efficient cores at low clocks to save power and heat. Great for background apps — turn Off for anything you want at full speed." />

                                    <TextBlock Style="{StaticResource RefName}" Text="Priority boost" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="The short priority bump Windows gives a window when it's focused. Leave enabled normally; disable for steadier, more predictable scheduling." />

                                    <TextBlock Style="{StaticResource RefName}" Text="GPU preference" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Which GPU the app launches on. High performance forces the discrete GPU (best for games); it applies the next time the app starts." />

                                    <TextBlock Style="{StaticResource RefName}" Text="GPU priority" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Scheduling priority for this process's work on the GPU relative to others. Higher favors it when the GPU is busy." />

                                    <TextBlock Style="{StaticResource RefName}" Text="Power profile" />
                                    <TextBlock Style="{StaticResource RefBody}" Text="Switches the whole system's Windows power plan (e.g. High performance) so the CPU/GPU clock up more aggressively while you play." />
                                </StackPanel>
                            </ScrollViewer>
                        </ui:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================ HARDWARE TABS ============================ -->
            <TabItem Style="{StaticResource MainTab}" Content="{Binding SystemTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Board24" Style="{StaticResource TabIcon}" />
